rules_version = '2';
// Cole no Firebase Console → Storage → Rules (plano Spark / gratuito)
// Só a pasta thumbs/ fica pública (galeria temporária).
service firebase.storage {
  match /b/{bucket}/o {
    match /thumbs/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }
  }
}
